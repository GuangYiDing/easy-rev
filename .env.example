# Easy-Rev configuration (prefix EASY_REV_)

EASY_REV_LOG_LEVEL=INFO
EASY_REV_ENGINE=auto
EASY_REV_HEADLESS=true

# Web browser / proxy
# EASY_REV_PROXY=host:port:user:pass
# EASY_REV_PROXY_FILE=./proxies/proxies.txt

# Chrome extension bridge
EASY_REV_BRIDGE_HOST=127.0.0.1
EASY_REV_BRIDGE_PORT=18766

# Frida remote / devices
# EASY_REV_FRIDA_HOST=127.0.0.1:27042
# EASY_REV_ADB_SERIAL=
# EASY_REV_IOS_UDID=
